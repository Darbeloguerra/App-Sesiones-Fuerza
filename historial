function PuntoEstado({ hecho }) {
  return (
    <span
      style={{
        width: 8,
        height: 8,
        borderRadius: "50%",
        background: hecho ? "#22C55E" : "#1A3050",
        border: hecho ? "none" : "1px solid #EF4444",
        flexShrink: 0,
        display: "inline-block",
      }}
    />
  );
}

function FilaTareaHistorial({ tarea: t, orden }) {
  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 3, paddingLeft: orden != null ? 0 : 4 }}>
      <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
        {orden != null && (
          <span
            style={{
              width: 16,
              height: 16,
              borderRadius: "50%",
              background: "#122440",
              color: "#F5C518",
              fontFamily: "'IBM Plex Mono', monospace",
              fontSize: 9,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              flexShrink: 0,
            }}
          >
            {orden}
          </span>
        )}
        <PuntoEstado hecho={t.hecho} />
        <span style={{ fontSize: 12, color: t.hecho ? "#F0F4FF" : "#4A6680", flex: 1 }}>{t.nombre}</span>
        {t.hecho && t.unidad && (
          <span
            style={{
              fontFamily: "'IBM Plex Mono', monospace",
              fontSize: 10.5,
              color: "#4A6680",
              textAlign: "right",
            }}
          >
            {t.cantidad} {t.unidad === "metros" ? "m" : "reps"}
            {t.carga ? ` · ${t.carga}kg` : ""}
            {t.subtipo ? ` (${t.subtipo})` : ""}
            {t.rir ? ` · RIR${t.rir}` : ""}
          </span>
        )}
      </div>
      {t.nota && (
        <div
          style={{
            marginLeft: orden != null ? 24 : 20,
            display: "flex",
            gap: 5,
            fontSize: 10.5,
            color: "#8BA4C0",
          }}
        >
          <span style={{ color: "#F97316", flexShrink: 0 }}>📝</span>
          <span>{t.nota}</span>
        </div>
      )}
    </div>
  );
}

function TarjetaDia({ dia }) {
  const [abierto, setAbierto] = useState(false);

  const totalTareas = dia.bloques.reduce((acc, b) => acc + b.tareas.length, 0);
  const hechas = dia.bloques.reduce((acc, b) => acc + b.tareas.filter((t) => t.hecho).length, 0);

  return (
    <div
      style={{
        background: "#0E1E35",
        border: "1px solid #1A3050",
        borderRadius: 10,
        overflow: "hidden",
      }}
    >
      <div
        onClick={() => setAbierto((v) => !v)}
        style={{
          display: "flex",
          alignItems: "center",
          gap: 10,
          padding: "12px 14px",
          cursor: "pointer",
        }}
      >
        <div style={{ flex: 1 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <span style={{ fontSize: 13.5, fontWeight: 600, color: "#F0F4FF" }}>{dia.fecha}</span>
            {dia.md && (
              <span
                style={{
                  fontFamily: "'IBM Plex Mono', monospace",
                  fontSize: 9.5,
                  color: "#8BA4C0",
                  border: "1px solid #1A3050",
                  borderRadius: 4,
                  padding: "1px 5px",
                }}
              >
                {dia.md}
              </span>
            )}
          </div>
          <div style={{ fontSize: 11, color: "#4A6680", marginTop: 2 }}>
            {hechas}/{totalTareas} tareas completadas
          </div>
        </div>
        <span style={{ color: "#4A6680", fontSize: 12, transform: abierto ? "rotate(90deg)" : "none" }}>›</span>
      </div>


      {abierto && (
        <div style={{ borderTop: "1px solid #1A3050", padding: "10px 14px 14px", display: "flex", flexDirection: "column", gap: 10 }}>
          {dia.bloques.map((b) => (
            <div key={b.nombre}>
              <div style={{ display: "flex", alignItems: "center", gap: 6, marginBottom: 5 }}>
                <span style={{ fontSize: 12, fontWeight: 600, color: "#8BA4C0" }}>{b.nombre}</span>
                {b.categoria && (
                  <span style={{ fontSize: 10, color: "#F5C518", fontFamily: "'IBM Plex Mono', monospace" }}>
                    · {b.categoria}
                  </span>
                )}
              </div>
              {b.tareas.length === 0 && !(b.circuitos && b.circuitos.length) ? (
                <div style={{ fontSize: 11, color: "#4A6680", fontStyle: "italic", paddingLeft: 4 }}>
                  No aplicó ese día
                </div>
              ) : (
                <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
                  {b.tareas.map((t, i) => (
                    <FilaTareaHistorial key={i} tarea={t} />
                  ))}
                  {(b.circuitos || []).map((c, ci) => (
                    <div
                      key={ci}
                      style={{
                        border: "1px solid #F5C51840",
                        borderRadius: 8,
                        padding: "8px 8px",
                        display: "flex",
                        flexDirection: "column",
                        gap: 6,
                      }}
                    >
                      <span
                        style={{
                          alignSelf: "flex-start",
                          fontFamily: "'IBM Plex Mono', monospace",
                          fontSize: 9,
                          letterSpacing: "0.05em",
                          color: "#F5C518",
                          border: "1px solid #F5C51855",
                          borderRadius: 4,
                          padding: "1px 6px",
                        }}
                      >
                        CIRCUITO
                      </span>
                      {c.tareas.map((t, i) => (
                        <FilaTareaHistorial key={i} tarea={t} orden={i + 1} />
                      ))}
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

